---
import '@fontsource/cairo/arabic-400.css';
import '@fontsource/cairo/arabic-500.css';
import '@fontsource/cairo/arabic-600.css';
import '@fontsource/cairo/arabic-700.css';
import '@fontsource/cairo/latin-400.css';
import '@fontsource/cairo/latin-500.css';
import '@fontsource/cairo/latin-600.css';
import '@fontsource/cairo/latin-700.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE, dirOf, localePath, otherLang, t, type CategoryId, type Lang } from '../site';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  /** Path of this page in the other language, only when that page really exists. */
  alternatePath?: string;
  image?: string; // path under /public, e.g. /og/science.png
  type?: 'website' | 'article';
  published?: Date;
  modified?: Date;
  section?: string;
  tags?: string[];
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  isHome?: boolean;
  current?: 'home' | 'articles' | 'about' | 'search' | 'dyk';
  currentCategory?: CategoryId;
}

const {
  lang,
  title,
  description,
  alternatePath,
  image = '/og/default.png',
  type = 'website',
  published,
  modified,
  section,
  tags = [],
  jsonLd = [],
  noindex = false,
  isHome = false,
  current,
  currentCategory,
} = Astro.props;

const ui = t(lang);
const other = otherLang(lang);
const siteName = SITE.name[lang];
const fullTitle = isHome ? `${siteName} | ${SITE.tagline[lang]}` : `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const altUrl = alternatePath ? new URL(alternatePath, SITE.url).href : undefined;
const arUrl = lang === 'ar' ? canonical : altUrl;
const imageUrl = new URL(image, SITE.url).href;
const switchHref = alternatePath ?? localePath(other, '/');
const ogLocale = { ar: 'ar_AR', en: 'en_US' };
---

<!doctype html>
<html lang={lang} dir={dirOf(lang)}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    {
      /* Pages Google shouldn't index (404, search) get no canonical/hreflang, so they never point at URLs that don't exist. */
      !noindex && (
        <>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang={lang} href={canonical} />
          {altUrl && <link rel="alternate" hreflang={other} href={altUrl} />}
          {arUrl && <link rel="alternate" hreflang="x-default" href={arUrl} />}
        </>
      )
    }

    <meta property="og:site_name" content={siteName} />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content={ogLocale[lang]} />
    {altUrl && <meta property="og:locale:alternate" content={ogLocale[other]} />}
    {published && <meta property="article:published_time" content={published.toISOString()} />}
    {modified && <meta property="article:modified_time" content={modified.toISOString()} />}
    {section && <meta property="article:section" content={section} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="alternate" type="application/rss+xml" title={siteName} href={localePath(lang, '/rss.xml')} />
    <meta name="theme-color" content="#059669" />
    <meta name="generator" content={Astro.generator} />
    {SITE.googleSiteVerification && <meta name="google-site-verification" content={SITE.googleSiteVerification} />}

    {jsonLd.map((data) => <script type="application/ld+json" set:html={JSON.stringify(data)} />)}

    <script is:inline>
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'dark' || saved === 'light') document.documentElement.dataset.theme = saved;
      } catch {}
    </script>

    {
      SITE.googleAnalyticsId && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${SITE.googleAnalyticsId}`} />
          <script is:inline define:vars={{ id: SITE.googleAnalyticsId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', id);
          </script>
        </>
      )
    }
    {
      SITE.adsenseClient && (
        <script
          async
          src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${SITE.adsenseClient}`}
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.skip}</a>
    <Header lang={lang} switchHref={switchHref} current={current} currentCategory={currentCategory} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
