---
interface Props {
  id: string; // unique per page, used for the gradient id
  class?: string;
}
const { id, class: className } = Astro.props;
const gid = `logo-grad-${id}`;
---

<svg class={className} viewBox="0 0 40 40" aria-hidden="true">
  <defs>
    <linearGradient id={gid} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#5a48ee"></stop>
      <stop offset="1" stop-color="#b14bf4"></stop>
    </linearGradient>
  </defs>
  <rect width="40" height="40" rx="12" fill={`url(#${gid})`}></rect>
  <circle cx="20" cy="12.6" r="3.3" fill="#fff"></circle>
  <rect x="16.7" y="18.2" width="6.6" height="13.4" rx="3.3" fill="#fff"></rect>
  <path d="M30.6 6.5l1.05 2.75 2.75 1.05-2.75 1.05-1.05 2.75-1.05-2.75-2.75-1.05 2.75-1.05z" fill="#f5a524"></path>
</svg>
