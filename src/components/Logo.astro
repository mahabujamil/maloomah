  <rect width="40" height="40" rx="12" fill="#0b2545"></rect>
  <circle cx="20" cy="12.6" r="3.3" fill="#ffc93c"></circle>
  <rect x="16.7" y="18.2" width="6.6" height="13.4" rx="3.3" fill="#ffc93c"></rect>
  <path d="M30.6 6.5l1.05 2.75 2.75 1.05-2.75 1.05-1.05 2.75-1.05-2.75-2.75-1.05 2.75-1.05z" fill="#ffffff"></path>
