---
import Icon from './Icon.astro';
import Logo from './Logo.astro';
import { SITE, localePath, t, type CategoryId, type Lang } from '../site';

interface Props {
  lang: Lang;
  switchHref: string; // same page in the other language (or its home page)
  current?: 'home' | 'articles' | 'about' | 'search' | 'dyk';
  currentCategory?: CategoryId;
}
const { lang, switchHref, current, currentCategory } = Astro.props;
const ui = t(lang);
const home = localePath(lang, '/');
// Template «منصّة دروس» (2026-11-06): one row, the active link underlined in yellow, a yellow
// «ابدأ التعلّم» button. «المواد الدراسية» jumps to the subjects section of the home page.
const nav = [
  { key: 'home', label: ui.home, href: home },
  { key: 'subjects', label: ui.navSubjects, href: `${home}#subjects` },
  { key: 'dyk', label: ui.dykNav, href: localePath(lang, '/did-you-know/') },
  { key: 'articles', label: ui.navLessons, href: localePath(lang, '/articles/') },
  { key: 'about', label: ui.about, href: localePath(lang, '/about/') },
] as const;
const active = currentCategory ? 'articles' : current;
---

<header class="site-header">
  <div class="container header-row">
    <a class="logo" href={home} aria-label={SITE.name[lang]}>
      <Logo class="logo-mark" />
      <span class="logo-text">{SITE.name[lang]}</span>
    </a>

    <nav class="main-nav" aria-label={ui.menu}>
      {
        nav.map((item) => (
          <a href={item.href} aria-current={active === item.key ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a class="icon-btn" href={localePath(lang, '/search/')} aria-label={ui.search}>
        <Icon name="search" />
      </a>
      <a class="lang-btn" href={switchHref} hreflang={lang === 'ar' ? 'en' : 'ar'} lang={lang === 'ar' ? 'en' : 'ar'}>
        <span class="lang-full">{ui.otherLangName}</span>
        <span class="lang-short">{ui.otherLangShort}</span>
      </a>
      <button class="icon-btn theme-toggle" type="button" aria-label={ui.toggleTheme} data-theme-toggle>
        <Icon name="moon" class="icon-moon" />
        <Icon name="sun" class="icon-sun" />
      </button>
      <a class="btn btn-accent header-cta" href={`${home}#subjects`}>{ui.ctaStart}</a>
      <button class="icon-btn menu-btn" type="button" aria-label={ui.menu} aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
        <Icon name="menu" />
      </button>
    </div>
  </div>

  <div class="container mobile-menu" id="mobile-menu">
    <form class="search-field compact mobile-search" action={localePath(lang, '/search/')} method="get" role="search">
      <Icon name="search" size={18} />
      <input type="search" name="q" placeholder={ui.searchPlaceholder} aria-label={ui.search} />
    </form>
    <nav aria-label={ui.menu}>
      {
        nav.map((item) => (
          <a href={item.href} aria-current={active === item.key ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
      <a href={localePath(lang, '/contact/')}>{ui.contact}</a>
    </nav>
    <a class="btn btn-accent mobile-cta" href={`${home}#subjects`}>{ui.ctaStart}</a>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  toggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const current =
      root.dataset.theme ?? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
    const next = current === 'dark' ? 'light' : 'dark';
    root.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });

  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  menuBtn?.addEventListener('click', () => {
    const open = menu?.classList.toggle('open') ?? false;
    menuBtn.setAttribute('aria-expanded', String(open));
  });
  // Close the phone menu after picking «المواد الدراسية» (an in-page link on the home page).
  menu?.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('a[href*="#"]')) {
      menu.classList.remove('open');
      menuBtn?.setAttribute('aria-expanded', 'false');
    }
  });
</script>
