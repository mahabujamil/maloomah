---
// Home page in the «منصّة دروس» template Mahmoud picked on 2026-11-06 (navy + yellow):
// navy hero with the stage card, stats strip, 8 daily facts, subject cards, lesson rows, teacher band.
import BaseLayout from '../layouts/BaseLayout.astro';
import DailyFacts from '../components/DailyFacts.astro';
import Icon from '../components/Icon.astro';
import LessonRow from '../components/LessonRow.astro';
import TrendingBlock from '../components/TrendingBlock.astro';
import { LEVEL_IDS, SUBJECTS, SUBJECT_IDS, factsBySubject } from '../data/did-you-know';
import { TRENDING, isTrending } from '../data/trending';
import { getArticles, slugOf } from '../lib/content';
import { CATEGORIES, OTHER_CATEGORY_IDS, SITE, STUDY_CATEGORY_IDS, localePath, otherLang, t, type Lang } from '../site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const articles = await getArticles(lang);
const latest = articles.filter((a) => !isTrending(slugOf(a))).slice(0, 6);

// «من أرشيف معلومة»: six older articles not shown above, reshuffled every day
// (the site rebuilds each morning), so older articles keep appearing on the home page.
const shown = new Set([...TRENDING, ...latest.map(slugOf)]);
const day = Math.floor(Date.now() / 86_400_000);
const hash = (s: string) => [...s].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, day);
const archive = articles
  .filter((a) => !shown.has(slugOf(a)))
  .sort((a, b) => hash(slugOf(a)) - hash(slugOf(b)))
  .slice(0, 6);
// Rounded down to the hundred, so the "+" stays true as facts are added.
const factTotal = SUBJECT_IDS.reduce((n, id) => n + factsBySubject(id).length, 0);
const factsShown = factTotal >= 100 ? Math.floor(factTotal / 100) * 100 : factTotal;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name[lang],
    alternateName: SITE.name[otherLang(lang)],
    url: new URL(localePath(lang, '/'), SITE.url).href,
    inLanguage: lang,
    description: SITE.description[lang],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name[lang],
    url: SITE.url,
    logo: `${SITE.url}/apple-touch-icon.png`,
    email: SITE.email,
  },
];
---

<BaseLayout
  lang={lang}
  title={SITE.name[lang]}
  description={SITE.description[lang]}
  alternatePath={localePath(otherLang(lang), '/')}
  jsonLd={jsonLd}
  isHome
  current="home"
>
  <section class="hero">
    <span class="hero-deco hero-deco-ring" aria-hidden="true"></span>
    <span class="hero-deco hero-deco-dot" aria-hidden="true"></span>
    <div class="container hero-grid">
      <div>
        <span class="hero-kicker reveal">{ui.heroKicker}</span>
        <h1 class="reveal reveal-2">
          {ui.heroTitleA}
          <br />
          <span class="hero-hl">{ui.heroTitleB}</span>
        </h1>
        <p class="hero-text reveal reveal-2">{ui.heroText}</p>
        <form class="search-field hero-search reveal reveal-3" action={localePath(lang, '/search/')} method="get" role="search">
          <Icon name="search" />
          <input type="search" name="q" placeholder={ui.searchPlaceholder} aria-label={ui.search} />
          <button class="btn btn-accent" type="submit">{ui.search}</button>
        </form>
      </div>
      <aside class="stage-card reveal reveal-3" aria-labelledby="stage-card-title">
        <h2 id="stage-card-title">{ui.stageCardTitle}</h2>
        {
          LEVEL_IDS.map((level) => (
            <a class="stage-row" href={localePath(lang, `/did-you-know/?level=${level}#browse`)}>
              <span class="stage-mark" aria-hidden="true">{ui.stages[level].mark}</span>
              <span class="stage-info">
                <strong>{ui.stages[level].name}</strong>
                <span>{ui.stages[level].text}</span>
              </span>
              <Icon name="arrow" size={20} class="flip-rtl stage-arrow" />
            </a>
          ))
        }
      </aside>
    </div>
  </section>

  <div class="container">
    <div class="stats-strip reveal reveal-4">
      <div><strong><bdi>{factsShown}+</bdi></strong><span>{ui.statFacts}</span></div>
      <div><strong><bdi>{articles.length}+</bdi></strong><span>{ui.statArticles}</span></div>
      <div><strong>{SUBJECT_IDS.length}</strong><span>{ui.statSubjects}</span></div>
    </div>
  </div>

  <DailyFacts lang={lang} />

  <section class="section" id="subjects">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>{ui.studyTitle}</h2>
          <p>{ui.studyText}</p>
        </div>
      </div>
      <div class="subject-grid">
        {
          SUBJECT_IDS.map((id) => (
            <a class="subject-card" href={localePath(lang, `/did-you-know/${id}/`)}>
              <span class="subject-icon"><Icon name={SUBJECTS[id].icon} size={26} /></span>
              <span class="subject-text">
                <strong>{SUBJECTS[id].name[lang]}</strong>
                <span class="subject-go">{ui.subjectBrowse} <Icon name="arrow" size={15} class="flip-rtl" /></span>
              </span>
            </a>
          ))
        }
      </div>
      <nav class="lesson-cats" aria-labelledby="lesson-cats-title">
        <h3 id="lesson-cats-title">{ui.lessonCategories}:</h3>
        {
          [...STUDY_CATEGORY_IDS, ...OTHER_CATEGORY_IDS].map((id) => (
            <a class="chip" href={localePath(lang, `/category/${id}/`)}>
              <Icon name={id} size={15} />
              {CATEGORIES[id].name[lang]}
            </a>
          ))
        }
      </nav>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>{ui.latestLessons}</h2>
        <a class="section-link" href={localePath(lang, '/articles/')}>
          {ui.allLessons}
          <Icon name="arrow" size={18} class="flip-rtl" />
        </a>
      </div>
      <div class="lesson-grid">
        {latest.map((article) => <LessonRow article={article} lang={lang} />)}
      </div>
    </div>
  </section>

  <TrendingBlock lang={lang} articles={articles} />

  {
    archive.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <div>
              <h2>{ui.archiveTitle}</h2>
              <p>{ui.archiveText}</p>
            </div>
            <a class="section-link" href={localePath(lang, '/articles/')}>
              {ui.allLessons}
              <Icon name="arrow" size={18} class="flip-rtl" />
            </a>
          </div>
          <div class="lesson-grid">
            {archive.map((article) => <LessonRow article={article} lang={lang} />)}
          </div>
        </div>
      </section>
    )
  }

  <section class="section">
    <div class="container">
      <div class="teacher-band">
        <div>
          <h2>{ui.teacherTitle}</h2>
          <p>{ui.teacherText}</p>
        </div>
        <a class="btn" href={localePath(lang, '/did-you-know/')}>{ui.teacherBtn}</a>
      </div>
    </div>
  </section>
</BaseLayout>
