---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import FactCard from '../components/FactCard.astro';
import FactOfTheDay from '../components/FactOfTheDay.astro';
import Icon from '../components/Icon.astro';
import TrendingBlock from '../components/TrendingBlock.astro';
import { LEVEL_IDS, SUBJECTS, SUBJECT_IDS, factsBySubject, type SubjectId } from '../data/did-you-know';
import { isTrending } from '../data/trending';
import { getArticles, slugOf } from '../lib/content';
import { CATEGORIES, CATEGORY_IDS, SITE, localePath, otherLang, t, type Lang } from '../site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const articles = await getArticles(lang);
const latest = articles.filter((a) => !isTrending(slugOf(a))).slice(0, 6);
const countBy = (id: string) => articles.filter((a) => a.data.category === id).length;
// Four facts per subject for the home tabs, mixing school stages.
const sampleFacts = (id: SubjectId) => {
  const byLevel = LEVEL_IDS.map((level) => factsBySubject(id).filter((x) => x.level === level));
  const out = [];
  for (let i = 0; out.length < 4 && i < 12; i++) {
    const pick = byLevel[i % 3][Math.floor(i / 3)];
    if (pick) out.push(pick);
  }
  return out;
};

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name[lang],
    alternateName: SITE.name[otherLang(lang)],
    url: new URL(localePath(lang, '/'), SITE.url).href,
    inLanguage: lang,
    description: SITE.description[lang],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name[lang],
    url: SITE.url,
    logo: `${SITE.url}/apple-touch-icon.png`,
    email: SITE.email,
  },
];
---

<BaseLayout
  lang={lang}
  title={SITE.name[lang]}
  description={SITE.description[lang]}
  alternatePath={localePath(otherLang(lang), '/')}
  jsonLd={jsonLd}
  isHome
  current="home"
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="kicker reveal"><span class="dot"><Icon name="sparkle" size={14} /></span>{ui.heroKicker}</span>
        <h1 class="reveal reveal-2">
          {ui.heroTitleA}
          <br />
          <span class="gradient-text">{ui.heroTitleB}</span>
        </h1>
        <p class="hero-text reveal reveal-2">{ui.heroText}</p>
        <form class="search-field hero-search reveal reveal-3" action={localePath(lang, '/search/')} method="get" role="search">
          <Icon name="search" />
          <input type="search" name="q" placeholder={ui.searchPlaceholder} aria-label={ui.search} />
          <button class="btn btn-primary" type="submit">{ui.search}</button>
        </form>
        <div class="stats reveal reveal-4">
          <div class="stat"><strong><bdi>{articles.length}+</bdi></strong><span>{ui.statArticles}</span></div>
          <div class="stat"><strong>{CATEGORY_IDS.length}</strong><span>{ui.statCategories}</span></div>
          <div class="stat"><strong>2</strong><span>{ui.statLangs}</span></div>
        </div>
      </div>
      <FactOfTheDay lang={lang} />
    </div>
  </section>

  <TrendingBlock lang={lang} articles={articles} />

  <section class="section">
    <div class="container">
      <div class="dyk-home">
        <div class="section-head">
          <div>
            <h2><Icon name="bulb" size={26} class="dyk-home-icon" />{ui.dykHomeTitle}</h2>
            <p>{ui.dykHomeText}</p>
          </div>
          <a class="section-link" href={localePath(lang, '/did-you-know/')}>
            {ui.dykAllFacts}
            <Icon name="arrow" size={18} class="flip-rtl" />
          </a>
        </div>
        <div class="dyk-tabs" role="tablist" aria-label={ui.dykSubjects}>
          {
            SUBJECT_IDS.map((id, i) => (
              <button
                class="dyk-tab"
                type="button"
                role="tab"
                id={`dyk-tab-${id}`}
                aria-controls={`dyk-panel-${id}`}
                aria-selected={i === 0 ? 'true' : 'false'}
                tabindex={i === 0 ? 0 : -1}
                style={`--c1:${SUBJECTS[id].colors[0]}`}
              >
                <Icon name={SUBJECTS[id].icon} size={16} />
                {SUBJECTS[id].name[lang]}
              </button>
            ))
          }
        </div>
        {
          SUBJECT_IDS.map((id, i) => (
            <div class="dyk-panel" role="tabpanel" id={`dyk-panel-${id}`} aria-labelledby={`dyk-tab-${id}`} hidden={i !== 0}>
              <div class="dyk-grid">
                {sampleFacts(id).map((fact) => (
                  <FactCard fact={fact} lang={lang} showSubject={false} />
                ))}
              </div>
              <a class="btn btn-ghost dyk-more" href={localePath(lang, `/did-you-know/${id}/`)}>
                {SUBJECTS[id].title[lang]}
                <Icon name="arrow" size={16} class="flip-rtl" />
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>{ui.exploreCategories}</h2>
        </div>
      </div>
      <div class="cat-grid">
        {
          CATEGORY_IDS.map((id) => {
            const cat = CATEGORIES[id];
            return (
              <a class="cat-tile" href={localePath(lang, `/category/${id}/`)} style={`--c1:${cat.colors[0]};--c2:${cat.colors[1]}`}>
                <span class="cat-icon"><Icon name={id} size={24} /></span>
                <span class="cat-name">{cat.name[lang]}</span>
                <span class="cat-desc">{cat.description[lang]}</span>
                <span class="cat-count">{ui.articlesIn(countBy(id))}</span>
              </a>
            );
          })
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>{ui.latest}</h2>
        <a class="section-link" href={localePath(lang, '/articles/')}>
          {ui.viewAll}
          <Icon name="arrow" size={18} class="flip-rtl" />
        </a>
      </div>
      <div class="grid grid-3">
        {latest.map((article) => <ArticleCard article={article} lang={lang} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.dyk-tab')];
  const select = (tab: HTMLButtonElement) => {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
      if (panel) panel.hidden = !on;
    }
  };
  tabs.forEach((tab, i) => {
    tab.addEventListener('click', () => select(tab));
    tab.addEventListener('keydown', (e) => {
      const rtl = document.documentElement.dir === 'rtl';
      const step = { ArrowRight: rtl ? -1 : 1, ArrowLeft: rtl ? 1 : -1 }[e.key];
      if (!step) return;
      const next = tabs[(i + step + tabs.length) % tabs.length];
      next.focus();
      select(next);
    });
  });
</script>
