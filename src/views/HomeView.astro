---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import DailyFacts from '../components/DailyFacts.astro';
import Icon from '../components/Icon.astro';
import TrendingBlock from '../components/TrendingBlock.astro';
import { LEVELS, LEVEL_IDS, SUBJECTS, SUBJECT_IDS, factsBySubject } from '../data/did-you-know';
import { TRENDING, isTrending } from '../data/trending';
import { getArticles, slugOf } from '../lib/content';
import { CATEGORIES, OTHER_CATEGORY_IDS, SITE, STUDY_CATEGORY_IDS, localePath, otherLang, t, type Lang } from '../site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const ui = t(lang);
const articles = await getArticles(lang);
const latest = articles.filter((a) => !isTrending(slugOf(a))).slice(0, 6);

// «من أرشيف معلومة»: six older articles not shown above, reshuffled every day
// (the site rebuilds each morning), so older articles keep appearing on the home page.
const shown = new Set([...TRENDING, ...latest.map(slugOf)]);
const day = Math.floor(Date.now() / 86_400_000);
const hash = (s: string) => [...s].reduce((h, c) => (h * 31 + c.charCodeAt(0)) >>> 0, day);
const archive = articles
  .filter((a) => !shown.has(slugOf(a)))
  .sort((a, b) => hash(slugOf(a)) - hash(slugOf(b)))
  .slice(0, 6);
const countBy = (id: string) => articles.filter((a) => a.data.category === id).length;
// Rounded down to the hundred, so the "+" stays true as facts are added.
const factTotal = SUBJECT_IDS.reduce((n, id) => n + factsBySubject(id).length, 0);
const factsShown = factTotal >= 100 ? Math.floor(factTotal / 100) * 100 : factTotal;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebSite',
    name: SITE.name[lang],
    alternateName: SITE.name[otherLang(lang)],
    url: new URL(localePath(lang, '/'), SITE.url).href,
    inLanguage: lang,
    description: SITE.description[lang],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Organization',
    name: SITE.name[lang],
    url: SITE.url,
    logo: `${SITE.url}/apple-touch-icon.png`,
    email: SITE.email,
  },
];
---

<BaseLayout
  lang={lang}
  title={SITE.name[lang]}
  description={SITE.description[lang]}
  alternatePath={localePath(otherLang(lang), '/')}
  jsonLd={jsonLd}
  isHome
  current="home"
>
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="kicker reveal"><span class="dot"><Icon name="sparkle" size={14} /></span>{ui.heroKicker}</span>
        <h1 class="reveal reveal-2">
          {ui.heroTitleA}
          <br />
          <span class="gradient-text">{ui.heroTitleB}</span>
        </h1>
        <p class="hero-text reveal reveal-2">{ui.heroText}</p>
        <form class="search-field hero-search reveal reveal-3" action={localePath(lang, '/search/')} method="get" role="search">
          <Icon name="search" />
          <input type="search" name="q" placeholder={ui.searchPlaceholder} aria-label={ui.search} />
          <button class="btn btn-primary" type="submit">{ui.search}</button>
        </form>
        <div class="stage-pick reveal reveal-3">
          <span class="stage-label">{ui.stagePick}</span>
          {
            LEVEL_IDS.map((level) => (
              <a class="stage-btn" href={localePath(lang, `/did-you-know/?level=${level}#browse`)} style={`--c1:${LEVELS[level].color}`}>
                <Icon name="school" size={17} />
                {LEVELS[level].name[lang]}
              </a>
            ))
          }
        </div>
        <div class="stats reveal reveal-4">
          <div class="stat"><strong><bdi>{factsShown}+</bdi></strong><span>{ui.statFacts}</span></div>
          <div class="stat"><strong><bdi>{articles.length}+</bdi></strong><span>{ui.statArticles}</span></div>
          <div class="stat"><strong>{SUBJECT_IDS.length}</strong><span>{ui.statSubjects}</span></div>
        </div>
      </div>
      <aside class="subject-panel reveal reveal-3" aria-labelledby="subject-panel-title">
        <div class="subject-panel-head">
          <h2 id="subject-panel-title">{ui.subjectPanelTitle}</h2>
          <p>{ui.subjectPanelText}</p>
        </div>
        <div class="subject-panel-grid">
          {
            SUBJECT_IDS.map((id) => (
              <a class="subject-pill" href={localePath(lang, `/did-you-know/${id}/`)} style={`--c1:${SUBJECTS[id].colors[0]};--c2:${SUBJECTS[id].colors[1]}`}>
                <span class="subject-pill-icon"><Icon name={SUBJECTS[id].icon} size={22} /></span>
                <span class="subject-pill-name">{SUBJECTS[id].name[lang]}</span>
              </a>
            ))
          }
        </div>
      </aside>
    </div>
  </section>

  <DailyFacts lang={lang} />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <h2>{ui.studyTitle}</h2>
          <p>{ui.studyText}</p>
        </div>
      </div>
      <div class="cat-grid study-grid">
        {
          STUDY_CATEGORY_IDS.map((id) => {
            const cat = CATEGORIES[id];
            return (
              <a class="cat-tile" href={localePath(lang, `/category/${id}/`)} style={`--c1:${cat.colors[0]};--c2:${cat.colors[1]}`}>
                <span class="cat-icon"><Icon name={id} size={24} /></span>
                <span class="cat-name">{cat.name[lang]}</span>
                <span class="cat-desc">{cat.description[lang]}</span>
                <span class="cat-count">{ui.articlesIn(countBy(id))}</span>
              </a>
            );
          })
        }
        <a class="cat-tile" href={localePath(lang, "/did-you-know/")} style="--c1:#d97706;--c2:#f59e0b">
          <span class="cat-icon"><Icon name="bulb" size={24} /></span>
          <span class="cat-name">{ui.dykNav}</span>
          <span class="cat-desc">{ui.dykHomeText}</span>
          <span class="cat-count">{ui.dykFacts(factTotal)}</span>
        </a>
      </div>
      <div class="other-cats">
        <h3>{ui.otherCategories}</h3>
        <div class="other-cats-row">
          {
            OTHER_CATEGORY_IDS.map((id) => (
              <a class="chip" style={`--c1:${CATEGORIES[id].colors[0]}`} href={localePath(lang, `/category/${id}/`)}>
                <Icon name={id} size={15} />
                {CATEGORIES[id].name[lang]}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>{ui.latestLessons}</h2>
        <a class="section-link" href={localePath(lang, '/articles/')}>
          {ui.viewAll}
          <Icon name="arrow" size={18} class="flip-rtl" />
        </a>
      </div>
      <div class="grid grid-3">
        {latest.map((article) => <ArticleCard article={article} lang={lang} />)}
      </div>
    </div>
  </section>

  <TrendingBlock lang={lang} articles={articles} />

  {
    archive.length > 0 && (
      <section class="section">
        <div class="container">
          <div class="section-head">
            <div>
              <h2>{ui.archiveTitle}</h2>
              <p>{ui.archiveText}</p>
            </div>
            <a class="section-link" href={localePath(lang, '/articles/')}>
              {ui.allArticles}
              <Icon name="arrow" size={18} class="flip-rtl" />
            </a>
          </div>
          <div class="grid grid-3">
            {archive.map((article) => (
              <ArticleCard article={article} lang={lang} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

