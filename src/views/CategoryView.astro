---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import { categoryUrl, getArticles } from '../lib/content';
import { CATEGORIES, SITE, localePath, otherLang, t, type CategoryId, type Lang } from '../site';

interface Props {
  lang: Lang;
  category: CategoryId;
}
const { lang, category } = Astro.props;
const ui = t(lang);
const cat = CATEGORIES[category];
const articles = (await getArticles(lang)).filter((a) => a.data.category === category);
const home = localePath(lang, '/');

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: cat.name[lang],
    description: cat.description[lang],
    url: new URL(categoryUrl(lang, category), SITE.url).href,
    inLanguage: lang,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: ui.breadcrumbHome, item: new URL(home, SITE.url).href },
      { '@type': 'ListItem', position: 2, name: cat.name[lang] },
    ],
  },
];
---

<BaseLayout
  lang={lang}
  title={cat.name[lang]}
  description={cat.description[lang]}
  alternatePath={categoryUrl(otherLang(lang), category)}
  image={`/og/${category}.png`}
  jsonLd={jsonLd}
  currentCategory={category}
>
  <section class="page-hero" style={`--c1:${cat.colors[0]};--c2:${cat.colors[1]}`}>
    <div class="container">
      <Breadcrumbs items={[{ label: ui.breadcrumbHome, href: home }, { label: cat.name[lang] }]} />
      <div style="display:flex;align-items:center;gap:16px;margin-top:18px">
        <span class="hero-icon"><Icon name={category} size={32} /></span>
        <div>
          <h1 style="margin-top:0">{cat.name[lang]}</h1>
          <p class="cat-count">{ui.articlesIn(articles.length)}</p>
        </div>
      </div>
      <p class="lead">{cat.description[lang]}</p>
    </div>
  </section>
  <section class="section">
    <div class="container grid grid-3">
      {articles.map((article) => <ArticleCard article={article} lang={lang} />)}
    </div>
  </section>
</BaseLayout>
