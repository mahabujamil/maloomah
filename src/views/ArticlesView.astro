---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import Pagination from '../components/Pagination.astro';
import type { Article } from '../lib/content';
import { SITE, localePath, otherLang, t, type Lang } from '../site';

interface Props {
  lang: Lang;
  page: { data: Article[]; currentPage: number; lastPage: number; total: number };
}
const { lang, page } = Astro.props;
const ui = t(lang);
const base = '/articles/';
const suffix = page.currentPage > 1 ? `${page.currentPage}/` : '';
const title = page.currentPage > 1 ? `${ui.allArticles} - ${ui.pageLabel(page.currentPage)}` : ui.allArticles;
const description =
  lang === 'ar'
    ? `تصفّح كل مقالات ${SITE.name.ar} في العلوم والصحة والتقنية والتاريخ والمال والمزيد.`
    : `Browse every ${SITE.name.en} article on science, health, technology, history, money and more.`;
---

<BaseLayout
  lang={lang}
  title={title}
  description={description}
  alternatePath={localePath(otherLang(lang), `${base}${suffix}`)}
  current="articles"
>
  <section class="page-hero">
    <div class="container">
      <Breadcrumbs items={[{ label: ui.breadcrumbHome, href: localePath(lang, '/') }, { label: ui.allArticles }]} />
      <div style="display:flex;align-items:center;gap:16px;margin-top:18px">
        <span class="hero-icon"><Icon name="book" size={30} /></span>
        <div>
          <h1 style="margin-top:0">{title}</h1>
          <p class="cat-count">{ui.articlesIn(page.total)}</p>
        </div>
      </div>
      <p class="lead">{description}</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="grid grid-3">
        {page.data.map((article) => <ArticleCard article={article} lang={lang} />)}
      </div>
      <Pagination lang={lang} basePath={localePath(lang, base)} current={page.currentPage} last={page.lastPage} />
    </div>
  </section>
</BaseLayout>
