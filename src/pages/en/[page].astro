---
import PageView from '../../views/PageView.astro';
import { getPages, slugOf } from '../../lib/content';

export async function getStaticPaths() {
  const pages = await getPages('en');
  return pages.map((page) => ({ params: { page: slugOf(page) }, props: { page } }));
}
const { page } = Astro.props;
---

<PageView lang="en" page={page} />
