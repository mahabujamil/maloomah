---
import ArticleView from '../../../views/ArticleView.astro';
import { getArticles, slugOf } from '../../../lib/content';

export async function getStaticPaths() {
  const articles = await getArticles('en');
  return articles.map((article) => ({ params: { slug: slugOf(article) }, props: { article } }));
}
const { article } = Astro.props;
---

<ArticleView lang="en" article={article} />
